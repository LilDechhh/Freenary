    <script>
        lucide.createIcons();

        // LOGIQUE D'AUTHENTIFICATION (Simulation)
        function handleLogin(e) {
            e.preventDefault();
            const loginScreen = document.getElementById('loginScreen');
            const appScreen = document.getElementById('appScreen');

            loginScreen.style.opacity = '0';
            setTimeout(() => {
                loginScreen.classList.add('view-hidden');
                appScreen.classList.remove('view-hidden');
                appScreen.classList.add('fade-in');
            }, 300);
        }

        function handleLogout() {
            const loginScreen = document.getElementById('loginScreen');
            const appScreen = document.getElementById('appScreen');

            appScreen.style.opacity = '0';
            setTimeout(() => {
                appScreen.classList.add('view-hidden');
                appScreen.style.opacity = '1';
                loginScreen.classList.remove('view-hidden');
                loginScreen.style.opacity = '1';
            }, 300);
        }

        // MENU MOBILE
        function toggleMobileMenu() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('mobileOverlay');

            if (sidebar.classList.contains('-translate-x-full')) {
                sidebar.classList.remove('-translate-x-full');
                overlay.classList.remove('hidden');
                setTimeout(() => overlay.classList.remove('opacity-0'), 10);
            } else {
                sidebar.classList.add('-translate-x-full');
                overlay.classList.add('opacity-0');
                setTimeout(() => overlay.classList.add('hidden'), 300);
            }
        }

        // NAVIGATION ENTRE CATÉGORIES
        let currentActiveCategory = 'global';

        function selectCategory(categoryId, categoryName) {
            currentActiveCategory = categoryId;

            // 1. Bouton actif dans la sidebar
            document.querySelectorAll('.category-btn').forEach(btn => btn.classList.remove('active'));
            document.getElementById('nav-' + categoryId).classList.add('active');

            // 2. Changer le titre du graphique
            document.getElementById('chart-title').innerText = categoryName;

            // 3. Sections
            const sectionRepartition = document.getElementById('section-repartition');
            const sectionAssets = document.getElementById('section-assets');
            const sectionHistory = document.getElementById('section-history');

            if (categoryId === 'global') {
                sectionRepartition.classList.remove('hidden');
                sectionAssets.classList.add('hidden');
                sectionHistory.classList.add('hidden');
            } else {
                sectionRepartition.classList.add('hidden');
                sectionAssets.classList.remove('hidden');
                sectionHistory.classList.remove('hidden');

                // Tbody Actifs
                document.querySelectorAll('.asset-tbody').forEach(tbody => tbody.classList.add('hidden'));
                document.getElementById('assets-' + categoryId).classList.remove('hidden');

                // Tbody Historique
                document.querySelectorAll('.history-tbody').forEach(tbody => tbody.classList.add('hidden'));
                document.getElementById('history-' + categoryId).classList.remove('hidden');
            }

            // Fermer mobile menu
            if (window.innerWidth < 768) {
                toggleMobileMenu();
            }
        }

        // GESTION DE LA MODALE
        const modal = document.getElementById('addModal');
        const modalContent = document.getElementById('modalContent');
        const modalCategorySelect = document.getElementById('modalCategory');

        function openModal() {
            if (currentActiveCategory !== 'global') {
                modalCategorySelect.value = currentActiveCategory;
            }
            modal.classList.remove('opacity-0', 'pointer-events-none');
            modalContent.classList.remove('scale-95');
            modalContent.classList.add('scale-100');
        }

        function closeModal() {
            modal.classList.add('opacity-0', 'pointer-events-none');
            modalContent.classList.remove('scale-100');
            modalContent.classList.add('scale-95');
        }
    </script>
